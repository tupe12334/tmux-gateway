  "info": {
    "description": "REST API for interacting with local tmux sessions",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "tmux-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/capture-pane": {
      "get": {
        "externalDocs": {
          "description": "tmux capture-pane",
          "url": "https://man.openbsd.org/tmux#capture-pane"
        },
        "operationId": "capture_pane",
        "parameters": [
          {
            "description": "Pane target",
            "in": "query",
            "name": "target",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapturePaneResponse"
                }
              }
            },
            "description": "Pane content captured"
          },
          "404": {
            "description": "Pane not found"
          },
          "500": {
            "description": "Failed to capture pane"
          }
        },
        "tags": []
      }
    },
    "/capture-pane-with-options": {
      "post": {
        "externalDocs": {
