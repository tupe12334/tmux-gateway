                }
              }
            },
            "description": "Pane content captured with options"
          },
          "404": {
            "description": "Pane not found"
          },
          "500": {
            "description": "Failed to capture pane"
          }
        },
        "tags": []
      }
    },
    "/create-session-with-windows": {
      "post": {
        "externalDocs": {
          "description": "tmux new-session",
          "url": "https://man.openbsd.org/tmux#new-session"
        },
        "operationId": "create_session_with_windows",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionWithWindowsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionWithWindowsResponse"
                }
              }
            },
            "description": "Session created with windows"
          },
          "400": {
            "description": "Invalid session or window name"
          },
          "409": {
            "description": "Session already exists"
          },
          "500": {
            "description": "Failed to create session"
          }
        },
        "tags": []
      }
    },
    "/get-option": {
      "get": {
        "externalDocs": {
          "description": "tmux show-options",
          "url": "https://man.openbsd.org/tmux#show-options"
        },
        "operationId": "get_option",
        "parameters": [
          {
            "description": "Option name",
            "in": "query",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Option scope: global, session, or window",
            "in": "query",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Target (session or window) for non-global scopes",
            "in": "query",
            "name": "target",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionResponse"
                }
              }
            },
            "description": "Option value retrieved"
          },
          "400": {
            "description": "Invalid option name or scope"
          },
          "500": {
            "description": "Failed to get option"
          }
        },
        "tags": []
      }
    },
    "/health": {
