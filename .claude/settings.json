{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(make build:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(cargo fmt:*)",
      "Bash(tmux new-session:*)",
      "Bash(cargo add:*)",
      "Bash(cargo doc:*)",
      "Bash(git status:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(docker build:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(centy start:*)",
      "Bash(centy init:*)",
      "Bash(centy list:*)",
      "Bash(centy create:*)",
      "Bash(docker run:*)",
      "Bash(docker stop:*)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:lib.rs)",
      "Bash(which centy:*)",
      "Bash(centy create:*)",
      "Bash(centy:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "WebSearch",
      "Bash(gh repo:*)",
      "Bash(find:*)",
      "Bash(uuidgen:*)",
      "Bash(centy list:*)",
      "Bash(tmux list-sessions:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux capture-pane:*)"
    ],
    "deny": ["Bash(gh issue create:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx block-no-verify"
          }
        ]
      }
    ]
  }
}
